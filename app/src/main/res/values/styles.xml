<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00FF9C</item>
        <item name="colorPrimaryVariant">#0B1E2D</item>
        <item name="colorOnPrimary">#0B1E2D</item>

        <item name="colorSecondary">#FFEB3B</item>
        <item name="colorOnSecondary">#0B1E2D</item>

        <item name="android:colorBackground">#0B1E2D</item>
        <item name="android:statusBarColor">#0B1E2D</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>
    <style name="AppTheme.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">#0B1E2D</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">#B3FFFFFF</item>
    </style>
<style name="AppTheme.Card" parent="Widget.MaterialComponents.CardView">
    <item name="android:background">#0B1E2D</item>
    <item name="strokeColor">#00FF9C</item>
    <item name="strokeWidth">1dp</item>
    <item name="cardElevation">4dp</item>
</style>
    <style name="AppTheme.Text.Primary">
        <item name="android:textColor">@android:color/white</item>

    </style>
    <style name="AppTheme.Text.Secondary">
        <item name="android:textColor">#B0FFFFFF</item>
    </style>
    <style name="AppTheme.Text">
        <item name="android:textColor">#112A3A</item>
    </style>
    <style name="Theme.AuthUI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#0B1E2D</item>
        <item name="colorPrimaryVariant">#0B1E2D</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>




</resources>