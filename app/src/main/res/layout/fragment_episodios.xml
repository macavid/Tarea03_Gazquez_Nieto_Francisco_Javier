<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0B1E2D"
  >

    <!-- CABECERA -->
    <com.google.android.material.card.MaterialCardView
        style="@style/AppTheme.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                style="@style/AppTheme.Text.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rick &amp; Morty"
                android:textStyle="bold"/>

            <TextView
                style="@style/AppTheme.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listado de episodios"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mostrar solo vistos"
                android:textColor="@android:color/white"
                android:textStyle="bold"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swSoloVistos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEpisodios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
